rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Menu items are public read, admin write
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Orders: users can read their own, admins can read/write all
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (request.auth.token.admin == true || request.auth.uid == resource.data.customerId);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Order updates (status history, etc.) locked to admins
    match /orderUpdates/{updateId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Delivery assignments restricted to admins
    match /deliveries/{deliveryId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
